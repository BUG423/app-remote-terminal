[Unit]
Description=Remote Terminal Agent (current user)
Wants=network-online.target
After=network-online.target

# Install this as a user unit with `systemctl --user`; never add User= or Group=.
[Service]
Type=simple
Environment=NODE_ENV=production
EnvironmentFile=%h/.config/remote-terminal/agent.env
ExecStart=/usr/bin/bash -lc 'cd -- "$REMOTE_TERMINAL_WORKING_DIRECTORY" && exec node "$REMOTE_TERMINAL_AGENT_ENTRY"'
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
KillSignal=SIGTERM
UMask=0077

LimitNOFILE=8192
TasksMax=256
MemoryHigh=768M
MemoryMax=1G

[Install]
WantedBy=default.target
