# Copy to ~/.config/remote-terminal/agent.env as the SAME user that runs Agent.
# Every path must already exist. Do not use sudo and do not create another user.
REMOTE_TERMINAL_WORKING_DIRECTORY=/absolute/path/to/existing/current/workspace
REMOTE_TERMINAL_AGENT_ENTRY=/absolute/path/to/remote-terminal/agent/index.js
CW_CONFIG_PATH=/absolute/path/to/remote-terminal/agent/config.json
