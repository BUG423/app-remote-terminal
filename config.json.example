{
  "_comment": "Remote Terminal Relay 配置；复制为 config.json，并执行 chmod 600 config.json",
  "port": 443,
  "bindHost": "0.0.0.0",

  "devices": {
    "server-a": {
      "name": "受控服务器 A",
      "browserToken": "change-me-browser-random-token-01",
      "agentToken": "change-me-agent-random-token-02"
    }
  },
  "_devices_comment": "每台设备必须使用彼此不同、至少 32 字符的 browserToken 和 agentToken",

  "maxSessions": 12,
  "maxBrowsersPerToken": 8,
  "maxTotalConnections": 200,
  "maxWsBufferedBytes": 2097152,
  "maxWsPayloadBytes": 1048576,
  "scrollbackBytes": 524288,
  "scrollbackRows": 10000,
  "maxSyncPendingBytes": 524288,
  "_limits_comment": "限制连接、会话、消息、浏览器背压和终端历史占用",

  "useTLS": true,
  "tlsCertPath": "/etc/remote-terminal/tls/fullchain.pem",
  "tlsKeyPath": "/etc/remote-terminal/tls/privkey.pem",
  "healthDetails": false,
  "_tls_comment": "Relay 原生提供 HTTPS/WSS；不监听 80，不提供网页端"
}
